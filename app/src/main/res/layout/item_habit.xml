<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/habit_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="20dp"
    android:layout_marginVertical="12dp"
    android:background="@drawable/gradient_other"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:padding="20dp"
    android:stateListAnimator="@null"
    app:cardCornerRadius="20dp"
    app:cardElevation="8dp">

    <!-- Category Icon -->
    <ImageView
        android:id="@+id/category_icon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:contentDescription="@string/habit_category"
        android:src="@drawable/ic_other"
        android:tint="@android:color/white"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Habit Title -->
    <TextView
        android:id="@+id/habit_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text="Drink Water"
        android:textAppearance="@style/TextAppearance.Material3.HeadlineSmall"
        android:textColor="@android:color/white"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@+id/completion_status"
        app:layout_constraintStart_toEndOf="@+id/category_icon"
        app:layout_constraintTop_toTopOf="@+id/category_icon"
        tools:text="Drink Water" />

    <!-- Habit Description (Target) -->
    <TextView
        android:id="@+id/habit_description"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Target: 8 glasses per day"
        android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
        android:textColor="@android:color/white"
        android:textStyle="italic"
        app:layout_constraintEnd_toStartOf="@+id/completion_status"
        app:layout_constraintStart_toStartOf="@+id/habit_title"
        app:layout_constraintTop_toBottomOf="@+id/habit_title"
        tools:text="Target: 8 glasses per day" />

    <!-- Completion Status (for boolean habits) -->
    <CheckBox
        android:id="@+id/completion_checkbox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:buttonTint="@android:color/white"
        android:contentDescription="@string/mark_complete"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:checked="false" />

    <!-- Circular Progress Ring (for countable habits) -->
    <ProgressBar
        android:id="@+id/circular_progress"
        style="?android:attr/progressBarStyle"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:indeterminate="false"
        android:max="100"
        android:progress="75"
        android:progressDrawable="@drawable/circular_progress_ring"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:progress="75"
        tools:visibility="visible" />

    <!-- Progress Text (for countable habits) -->
    <TextView
        android:id="@+id/progress_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="6/8"
        android:textAppearance="@style/TextAppearance.Material3.BodySmall"
        android:textColor="@android:color/white"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@+id/circular_progress"
        app:layout_constraintEnd_toEndOf="@+id/circular_progress"
        app:layout_constraintStart_toStartOf="@+id/circular_progress"
        app:layout_constraintTop_toTopOf="@+id/circular_progress"
        tools:text="6/8"
        tools:visibility="visible" />

    <!-- Linear Progress Bar (for countable habits) -->
    <ProgressBar
        android:id="@+id/linear_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="0dp"
        android:layout_height="6dp"
        android:layout_marginTop="12dp"
        android:max="100"
        android:progress="75"
        android:progressTint="@android:color/white"
        android:progressBackgroundTint="@android:color/white"
        android:alpha="0.3"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/habit_description"
        tools:progress="75"
        tools:visibility="visible" />

    <!-- Completion Count Layout (for countable habits) -->
    <LinearLayout
        android:id="@+id/completion_count_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/linear_progress"
        tools:visibility="visible">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/decrement_button"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:backgroundTint="@android:color/white"
            android:contentDescription="@string/decrement"
            app:icon="@drawable/ic_remove"
            app:iconSize="16dp"
            app:iconTint="?attr/colorPrimary" />

        <TextView
            android:id="@+id/completion_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginHorizontal="16dp"
            android:text="6"
            android:textAppearance="@style/TextAppearance.Material3.HeadlineSmall"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            tools:text="6" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/increment_button"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:backgroundTint="@android:color/white"
            android:contentDescription="@string/increment"
            app:icon="@drawable/ic_add"
            app:iconSize="16dp"
            app:iconTint="?attr/colorPrimary" />

    </LinearLayout>

    <!-- Action Buttons -->
    <LinearLayout
        android:id="@+id/action_buttons"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/completion_count_layout">

        <!-- Edit Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/edit_button"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="8dp"
            android:backgroundTint="@android:color/white"
            android:contentDescription="@string/edit_habit"
            app:icon="@drawable/ic_edit"
            app:iconSize="20dp"
            app:iconTint="?attr/colorPrimary" />

        <!-- Delete Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/delete_button"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:backgroundTint="@android:color/white"
            android:contentDescription="@string/delete_habit"
            app:icon="@drawable/ic_delete"
            app:iconSize="20dp"
            app:iconTint="?attr/colorError" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>